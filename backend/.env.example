PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# 1. For Local Development (Default):
MONGODB_URI=mongodb://127.0.0.1:27017/booknest

# 2. For Production with MongoDB Atlas:
# Set NODE_ENV=production in your deployment provider (e.g., Render, Railway, Vercel)
# and paste your MongoDB Atlas connection string as MONGODB_URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/booknest?retryWrites=true&w=majority

